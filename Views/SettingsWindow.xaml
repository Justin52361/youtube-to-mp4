<Window x:Class="YoutubeToMp4.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <StackPanel Margin="24">
        <TextBlock Text="Maximum resolution" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ListBox ItemsSource="{Binding Heights}" SelectedItem="{Binding MaxHeight}" Style="{StaticResource PillList}"
                 AutomationProperties.Name="Maximum resolution">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        <TextBlock Text="p" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Browser for login cookies" FontWeight="SemiBold" Margin="0,20,0,4"/>
        <TextBlock Text="Used only when &quot;Use my browser login&quot; is on. Firefox is the most reliable."
                   Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <ListBox ItemsSource="{Binding Browsers}" SelectedItem="{Binding CookieBrowser}" Style="{StaticResource PillList}"
                 AutomationProperties.Name="Browser for login cookies">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Style="{StaticResource PrimaryButton}" Content="Done" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,24,0,0" Click="OnDone"/>
    </StackPanel>
</Window>
